      "source": "def build_chat_server():\n    print(\"\ud83d\ude80 Initializing Zero-Syntax Graph Context for 'ChatCore'...\")\n    with GraphContext(\"ChatCore\") as ctx:\n        \n        # ---------------------------------------------------------\n        # FILE 1: client.py\n        # ---------------------------------------------------------\n        file_client = Node(\"FileNode\", \"client\")\n        ctx.add_node(file_client)\n        \n        cls_client = ClassNode(\"Client\")\n        file_client.add_child(cls_client)\n        \n        # def __init__(self, client_id): self.client_id = client_id\n        init_client = Function(\"__init__\", [\"self\", \"client_id\"])\n        init_client.properties[\"is_method\"] = True\n        var_client_id = Variable(\"self.client_id\", Identifier(\"client_id\"))\n        init_client.add_child(var_client_id)\n        cls_client.add_child(init_client)\n        \n        # def send(self, message): print(message)\n        send_client = Function(\"send\", [\"self\", \"message\"])\n        send_client.properties[\"is_method\"] = True\n        print_call = Call(\"print\", [\"message\"])\n        send_client.add_child(print_call)\n        cls_client.add_child(send_client)\n        \n        # ---------------------------------------------------------\n        # FILE 2: room.py\n        # ---------------------------------------------------------\n        file_room = Node(\"FileNode\", \"room\")\n        ctx.add_node(file_room)\n        \n        cls_room = ClassNode(\"Room\")\n        file_room.add_child(cls_room)\n        \n        # def __init__(self, name): self.name = name; self.clients = []\n        init_room = Function(\"__init__\", [\"self\", \"name\"])\n        init_room.properties[\"is_method\"] = True\n        init_room.add_child(Variable(\"self.name\", Identifier(\"name\")))\n        init_room.add_child(Variable(\"self.clients\", Node(\"ArrayNode\", \"array\")))\n        cls_room.add_child(init_room)\n        \n        # def add_client(self, client): self.clients.append(client)\n        add_client = Function(\"add_client\", [\"self\", \"client\"])\n        add_client.properties[\"is_method\"] = True\n        add_client.add_child(Call(\"self.clients.append\", [\"client\"]))\n        cls_room.add_child(add_client)\n        \n        # def broadcast(self, message): for c in self.clients: c.send(message)\n        broadcast = Function(\"broadcast\", [\"self\", \"message\"])\n        broadcast.properties[\"is_method\"] = True\n        loop = Loop(\"for\", \"c in self.clients\")\n        loop.add_statement(Call(\"c.send\", [\"message\"]))\n        broadcast.add_child(loop)\n        cls_room.add_child(broadcast)\n\n        # ---------------------------------------------------------\n        # FILE 3: server.py\n        # ---------------------------------------------------------\n        file_server = Node(\"FileNode\", \"server\")\n        ctx.add_node(file_server)\n        \n        cls_server = ClassNode(\"Server\")\n        file_server.add_child(cls_server)\n        \n        # def __init__(self): self.rooms = {}\n        init_server = Function(\"__init__\", [\"self\"])\n        init_server.properties[\"is_method\"] = True\n        init_server.add_child(Variable(\"self.rooms\", Node(\"DictNode\", \"dict\", {\"keys\": []})))\n        cls_server.add_child(init_server)\n        \n        # def create_room(self, name): self.rooms[name] = Room(name)\n        create_room = Function(\"create_room\", [\"self\", \"name\"])\n        create_room.properties[\"is_method\"] = True\n        create_room.add_child(Variable(\"self.rooms[name]\", Call(\"Room\", [\"name\"])))\n        cls_server.add_child(create_room)\n        \n        # def join_room(self, room_name, client):\n        #     target_room = self.rooms.get(room_name) # Using SAFE IndexAccess\n        #     if target_room:\n        #         target_room.add_client(client)\n        join_room = Function(\"join_room\", [\"self\", \"room_name\", \"client\"])\n        join_room.properties[\"is_method\"] = True\n        \n        safe_access = Node(\"IndexAccess\", \"idx\", {\"safe\": True})\n        safe_access.add_child(Identifier(\"self.rooms\"))\n        safe_access.add_child(Identifier(\"room_name\"))\n        \n        room_var = Variable(\"target_room\", safe_access)\n        \n        cond = Condition(Identifier(\"target_room\"), Block(\"true_block\").add_statement(Call(\"target_room.add_client\", [\"client\"])))\n        \n        join_room.add_child(room_var)\n        join_room.add_child(cond)\n        \n        cls_server.add_child(join_room)",
      "callers": []
    },
